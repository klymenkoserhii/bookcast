rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /loginEvents/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['userId', 'email', 'provider', 'userAgent', 'loggedInAt', 'expiresAt'])
        && request.resource.data.keys().hasOnly(['userId', 'email', 'provider', 'userAgent', 'loggedInAt', 'expiresAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', null)
        && ((request.resource.data.provider == 'google'
             && request.auth.token.firebase.sign_in_provider == 'google.com')
            || (request.resource.data.provider == 'password'
                && request.auth.token.firebase.sign_in_provider == 'password'))
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 1024
        && request.resource.data.loggedInAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(89, 'd')
        && request.resource.data.expiresAt <= request.time + duration.value(91, 'd');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
